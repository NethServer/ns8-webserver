#!/bin/bash

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#
set -e

version="${1:?We expect one argument}"
container="php${version}-fpm"
deb_list="php${version}-fpm-packages.list"
pecl_list="php${version}-fpm-pecl.list"
reload=0

# The lists are created at runtime, not shipped in imageroot/state: a module
# update overwrites every file extracted from the image
if [[ ! -f "${deb_list}" ]]; then
    cat > "${deb_list}" <<'EOF'
# Custom Debian packages installed in this PHP container.
# One package name per line, lines starting with # are ignored.
# The container is recreated at each start, so packages are installed again
# every time: restart phpfpm@<version>.service to apply this file.
EOF
fi

if [[ ! -f "${pecl_list}" ]]; then
    cat > "${pecl_list}" <<'EOF'
# Custom PECL extensions built and enabled in this PHP container.
# One extension per line, a version can be pinned as name-version.
# Build dependencies must be listed in the packages list above.
EOF
fi

read_list() {
    local file="${1}" pattern="${2}" entry
    while read -r entry; do
        # Reject anything else, an apt option or a shell metacharacter would
        # end up in the podman exec command line
        if [[ "${entry}" =~ ${pattern} ]]; then
            echo "${entry}"
        else
            echo "<3>Skipping invalid entry in ${file}: ${entry}" >&2
        fi
    done < <(sed -e 's/#.*//' -e 's/[[:space:]]//g' "${file}" | grep -v '^$')
}

mapfile -t packages < <(read_list "${deb_list}" '^[a-z0-9][a-z0-9+.-]*$')
missing=()
for name in "${packages[@]}"; do
    if ! podman exec "${container}" dpkg-query -W -f='${db:Status-Status}' "${name}" 2>/dev/null | grep -qx installed; then
        missing+=("${name}")
    fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Installing custom packages in ${container}: ${missing[*]}"
    podman exec -e DEBIAN_FRONTEND=noninteractive "${container}" apt-get update -qq
    podman exec -e DEBIAN_FRONTEND=noninteractive "${container}" apt-get install -y --no-install-recommends -- "${missing[@]}"
    reload=1
fi

mapfile -t extensions < <(read_list "${pecl_list}" '^[A-Za-z0-9_][A-Za-z0-9_.+-]*$')
for spec in "${extensions[@]}"; do
    # A pinned extension is written as name-version, PECL builds by name
    name="${spec%%-[0-9]*}"
    if podman exec "${container}" php -m | grep -qix "${name}"; then
        continue
    fi
    echo "Building PECL extension ${spec} in ${container}"
    podman exec "${container}" pecl install "${spec}"
    podman exec "${container}" docker-php-ext-enable "${name}"
    reload=1
done

if [[ ${reload} -eq 1 ]]; then
    # A package or an extension drops a .ini in conf.d, the php-fpm master
    # re-executes itself on USR2 and picks it up
    podman kill -s USR2 "${container}"
fi
