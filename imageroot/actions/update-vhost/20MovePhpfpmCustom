import os
import json
import sys
import glob

data = json.load(sys.stdin)

port = data.get('Port')
PhpVersion = data.get("PhpVersion")

# a static site has no php-fpm folder, its custom file stays where it is
if PhpVersion:
    os.makedirs(f"php{PhpVersion}-fpm-custom.d", exist_ok=True)
    for file in glob.glob(f"php*-fpm-custom.d/dyn-{port}.custom"):
        os.rename(file, f"php{PhpVersion}-fpm-custom.d/dyn-{port}.custom")
